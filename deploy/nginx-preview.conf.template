# Replace PREVIEW_DOMAIN and install as a separate server block.
server {
    listen 80;
    server_name PREVIEW_DOMAIN;
    location ^~ /.well-known/acme-challenge/ {
        root /var/lib/munyeon-preview/acme;
    }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    server_name PREVIEW_DOMAIN;
    ssl_certificate /etc/letsencrypt/live/PREVIEW_DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/PREVIEW_DOMAIN/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 160k;
    location / {
        proxy_pass http://127.0.0.1:4312;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Munyeon-Client-IP $remote_addr;
        proxy_read_timeout 60s;
    }
}
