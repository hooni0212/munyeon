PORT=4311
# 현재 시안은 모델 호출 없이 운영합니다. 명시적으로 1로 설정할 때만 연결합니다.
MUNYEON_AI_ENABLED=0
# 모델 서버의 OpenAI 호환 API 기본 주소. 예시 주소는 로컬 Ollama용.
# MUNYEON_AI_URL=http://127.0.0.1:11434/v1
# MUNYEON_AI_MODEL=
# MUNYEON_AI_KEY=

# 배포할 때 설정하는 도메인. https://와 경로는 입력하지 않습니다.
# MUNYEON_DOMAIN=munyeon.example.org
# MUNYEON_AI_DAILY_LIMIT=120
# MUNYEON_AI_OUTPUT_LIMIT_FIELD=max_tokens
# MUNYEON_DB_FILENAME=munyeon.sqlite
